// РАСШИРЕНИЕ ФОРМЫ ДОКУМЕНТА ПОСТУПЛЕНИЕТОВАРОВУСЛУГ
// МОДУЛЬ ФОРМЫ

&НаКлиенте
Перем Расш_РежимДокумента;

&Перед("ПриСозданииНаСервере")
Процедура Расш_ПередПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЭтаФорма.ИмеетРеквизит("Расш_РежимДокумента") Тогда
		
		МассивРеквизитов = Новый Массив;
		ТипСтрока = Новый ОписаниеТипов("Строка");
		МассивРеквизитов.Добавить(Новый РеквизитФормы("Расш_РежимДокумента", ТипСтрока, , "Режим документа"));
		
		ЭтаФорма.ИзменитьСоставРеквизитов(МассивРеквизитов);
		
	КонецЕсли;
	
КонецПроцедуры

&После("ПриСозданииНаСервере")
Процедура Расш_ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Расш_СоздатьЭлементыФормы();
	Расш_РежимДокумента = "Товары";
	Расш_ОбновитьВидимостьПоРежимуНаСервере(Расш_РежимДокумента);
	
КонецПроцедуры

&НаСервере
Процедура Расш_СоздатьЭлементыФормы()
	
	КомПанель = ЭтаФорма.Элементы.Найти("ФормаКоманднаяПанель");
	Если КомПанель = Неопределено Тогда
		КомПанель = ЭтаФорма.Элементы.Найти("ДокументКоманднаяПанель");
	КонецЕсли;
	Если КомПанель = Неопределено Тогда
		КомПанель = ЭтаФорма.Элементы.Найти("ОсновнаяГруппа");
	КонецЕсли;
	
	Если КомПанель <> Неопределено Тогда
		
		Если ЭтаФорма.Элементы.Найти("Расш_ГруппаУправления") = Неопределено Тогда
			
			НоваяГруппа = ЭтаФорма.Элементы.Вставить("Расш_ГруппаУправления", 
				Тип("ГруппаФормы"), КомПанель);
			НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			НоваяГруппа.Заголовок = "Управление расчетами";
			НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
			
			Переключатель = ЭтаФорма.Элементы.Вставить("Расш_РежимДокумента", 
				Тип("ПолеФормы"), НоваяГруппа);
			Переключатель.Вид = ВидПоляФормы.ПолеПереключателя;
			Переключатель.ПутьКДанным = "Расш_РежимДокумента";
			Переключатель.Заголовок = "Режим документа:";
			
			СписокВариантов = Новый СписокЗначений;
			СписокВариантов.Добавить("Товары", "Товары");
			СписокВариантов.Добавить("Услуги", "Услуги");
			Переключатель.СписокВыбора = СписокВариантов;
			
			Кнопка = ЭтаФорма.Элементы.Вставить("Расш_ЗаполнитьПоДомам", 
				Тип("КнопкаФормы"), НоваяГруппа);
			Кнопка.Заголовок = "Заполнить по домам";
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш_РежимДокументаПриИзменении(Элемент)
	
	Расш_ОбновитьВидимостьПоРежимуНаСервере(Расш_РежимДокумента);
	
КонецПроцедуры

&НаСервере
Процедура Расш_ОбновитьВидимостьПоРежимуНаСервере(Режим)
	
	СкладЭлемент = ЭтаФорма.Элементы.Найти("Склад");
	Если СкладЭлемент <> Неопределено Тогда
		СкладЭлемент.Видимость = (Режим = "Товары");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш_ЗаполнитьПоДомам(Команда)
	
	Если Расш_РежимДокумента <> "Услуги" Тогда
		ПоказатьПредупреждение(, "Распределение по домам доступно только в режиме ""Услуги""");
		Возврат;
	КонецЕсли;
	
	// Исправлено: используем ЭтаФорма.Объект
	Если ЭтаФорма.Объект.СуммаДокумента = 0 Тогда
		ПоказатьПредупреждение(, "itnСумма документа равна нулю. Заполнение невозможно.");
		Возврат;
	КонецЕсли;
	
	ОчиститьТЧ = Вопрос("Очистить текущий список услуг перед заполнением?", 
		РежимДиалогаВопрос.ДаНет, 0);
	
	Расш_ЗаполнитьПоДомамНаСервере(ОчиститьТЧ = КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаСервере
Процедура Расш_ЗаполнитьПоДомамНаСервере(ОчищатьТЧ)
	
	Если ОчищатьТЧ Тогда
		ЭтаФорма.Объект.Товары.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Расш_СвойстваНоменклатурныхГрупп.НоменклатурнаяГруппа КАК Дом,
	|	Расш_СвойстваНоменклатурныхГрупп.Площадь КАК Площадь
	|ИЗ
	|	РегистрСведений.Расш_СвойстваНоменклатурныхГрупп КАК Расш_СвойстваНоменклатурныхГрупп
	|ГДЕ
	|	Расш_СвойстваНоменклатурныхГрупп.Используется = ИСТИНА
	|	И Расш_СвойстваНоменклатурныхГрупп.Площадь > 0";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Сообщить("Нет домов, отмеченных для использования, с заполненной площадью");
		Возврат;
	КонецЕсли;
	
	ОбщаяПлощадь = 0;
	Для каждого Строка Из Результат Цикл
		ОбщаяПлощадь = ОбщаяПлощадь + Строка.Площадь;
	КонецЦикла;
	
	СуммаДокумента = ЭтаФорма.Объект.СуммаДокумента;
	СуммаНакоплено = 0;
	
	Для Индекс = 0 По Результат.Количество() - 1 Цикл
		
		Строка = Результат[Индекс];
		
		Если Индекс = Результат.Количество() - 1 Тогда
			СуммаСтроки = СуммаДокумента - СуммаНакоплено;
		Иначе
			СуммаСтроки = Окр(СуммаДокумента * Строка.Площадь / ОбщаяПлощадь, 2);
			СуммаНакоплено = СуммаНакоплено + СуммаСтроки;
		КонецЕсли;
		
		НоваяСтрока = ЭтаФорма.Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Строка.Дом;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.Цена = СуммаСтроки;
		НоваяСтрока.itnСумма = СуммаСтроки;
		
		Попытка
			НоваяСтрока.СтавкаНДС = ЭтаФорма.Объект.СтавкаНДС;
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	ЭтаФорма.Объект.Модифицированность = Истина;
	
	Сообщить("Выполнено распределение суммы " + Строка(СуммаДокумента) + 
		" по " + Строка(Результат.Количество()) + " домам");
	
КонецПроцедуры