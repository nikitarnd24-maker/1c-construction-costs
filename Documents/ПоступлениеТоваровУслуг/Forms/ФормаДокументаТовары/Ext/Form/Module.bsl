&НаКлиенте
Процедура itnЗаполнитьДомаПосле(Команда)
	
	Если Объект.Товары.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаЗаполнитьДома", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Таблица товаров уже содержит данные. Заменить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		itnЗаполнитьДомаПослеНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаЗаполнитьДома(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		itnЗаполнитьДомаПослеНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура itnЗаполнитьДомаПослеНаСервере()
	
	Объект.Товары.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеСвойстваНоменклатурныхГрупп.НоменклатурнаяГруппа КАК Дом
	|ИЗ
	|	РегистрСведений.ДополнительныеСвойстваНоменклатурныхГрупп КАК ДополнительныеСвойстваНоменклатурныхГрупп";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Сообщить("Нет домов в регистре.");
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из Результат Цикл
		НовСтрока = Объект.Товары.Добавить();
		
		НовСтрока.Номенклатура = Строка.Дом;
		НовСтрока.itnТоварыДом = Строка.Дом;
		
		Если ЗначениеЗаполнено(Объект.itnТоварыСчетЗатрат) Тогда
			НовСтрока.СчетУчета = Объект.itnТоварыСчетЗатрат;
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Загружено домов: " + Строка(Результат.Количество()));
	
КонецПроцедуры