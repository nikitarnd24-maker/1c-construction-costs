&НаКлиенте
Процедура itnЗаполнитьПеред(Команда)
	
	itnЗаполнитьПередНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура itnЗаполнитьПередНаСервере()
	
	Объект.itnДома.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеСвойстваНоменклатурныхГрупп.НоменклатурнаяГруппа КАК Дом,
	|	ДополнительныеСвойстваНоменклатурныхГрупп.Площадь КАК Площадь,
	|	ДополнительныеСвойстваНоменклатурныхГрупп.Используется КАК Использовать
	|ИЗ
	|	РегистрСведений.ДополнительныеСвойстваНоменклатурныхГрупп КАК ДополнительныеСвойстваНоменклатурныхГрупп";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для каждого Строка Из Результат Цикл
		НовСтрока = Объект.itnДома.Добавить();
		НовСтрока.Дом = Строка.Дом;
		НовСтрока.Площадь = Строка.Площадь;
		НовСтрока.Использовать = Строка.Использовать;
	КонецЦикла;
	
КонецПроцедуры               

&НаКлиенте
Процедура itnВыделитьВсёСнятьВыделениеПосле(Команда)

	Если Объект.itnДома.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
		КоличествоОтмеченных = 0;
	Для каждого Строка Из Объект.itnДома Цикл
		Если Строка.Использовать Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;
	
		Если КоличествоОтмеченных = Объект.itnДома.Количество() Тогда
		НовоеЗначение = Ложь;
	Иначе
		НовоеЗначение = Истина;
	КонецЕсли;
	
	Для каждого Строка Из Объект.itnДома Цикл
		Строка.Использовать = НовоеЗначение;
	КонецЦикла;
	
КонецПроцедуры   

&НаКлиенте
Процедура itnРаспределитьПосле(Команда)
	
	// Проверяем, есть ли сумма в документе
	Если Объект.itnСумма = 0 Тогда
		ПоказатьПредупреждение(, "Сумма документа равна нулю. Распределение невозможно.");
		Возврат;
	КонецЕсли;
	
	// Проверяем количество
	Если Объект.itnКоличествоНоменклатуры = 0 Тогда
		ПоказатьПредупреждение(, "Количество номенклатуры равно нулю. Распределение невозможно.");
		Возврат;
	КонецЕсли;
	
	// Проверяем, есть ли дома в таблице
	Если Объект.itnДома.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица домов пуста. Сначала заполните дома.");
		Возврат;
	КонецЕсли;
	
	// Вызываем серверную процедуру
	itnРаспределитьПослеНаСервере();
	
КонецПроцедуры
&НаСервере
Процедура itnРаспределитьПослеНаСервере()
	
	// 1. Считаем общую площадь только отмеченных домов
	ОбщаяПлощадь = 0;
	КоличествоДомов = 0;
	
	Для каждого Строка Из Объект.itnДома Цикл
		Если Строка.Использовать Тогда
			ОбщаяПлощадь = ОбщаяПлощадь + Строка.Площадь;
			КоличествоДомов = КоличествоДомов + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщаяПлощадь = 0 Тогда
		Сообщить("Нет отмеченных домов с заполненной площадью");
		Возврат;
	КонецЕсли;
	
	// 2. Получаем сумму документа и количество
	СуммаДокумента = Объект.itnСумма;
	КоличествоНоменклатуры = Объект.itnКоличествоНоменклатуры;
	
	// 3. Очищаем таблицу услуг
	Объект.Услуги.Очистить();
	
	// 4. Распределяем и заполняем услуги
	СуммаРаспределенная = 0;
	Индекс = 0;
	
	Для каждого Строка Из Объект.itnДома Цикл
		Если Строка.Использовать Тогда
			
			// Расчет суммы для текущего дома
			Доля = Строка.Площадь / ОбщаяПлощадь;
			
			Если Индекс = КоличествоДомов - 1 Тогда
				// Последний дом - берем остаток
				СуммаСтроки = СуммаДокумента - СуммаРаспределенная;
			Иначе
				СуммаСтроки = Окр(СуммаДокумента * Доля, 2);
				СуммаРаспределенная = СуммаРаспределенная + СуммаСтроки;
			КонецЕсли;
			
			// Добавляем строку в услуги
			НовУслуга = Объект.Услуги.Добавить();
			
			// === ОСНОВНЫЕ ПОЛЯ ===
			НовУслуга.Номенклатура = Строка.Дом;
			НовУслуга.Количество = КоличествоНоменклатуры;
			НовУслуга.Цена = СуммаСтроки / КоличествоНоменклатуры;
			НовУслуга.Сумма = СуммаСтроки;
			
			// === СТАВКА НДС ===
			Попытка
				Если ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
					НовУслуга.СтавкаНДС = Объект.СтавкаНДС;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			// === СОДЕРЖАНИЕ ===
			Попытка
				НовУслуга.Содержание = "Услуги по дому: " + Строка.Дом.Наименование;
			Исключение
			КонецПопытки;
			
						// === СУБКОНТО ===
			Попытка
			    // Субконто1 - Номенклатура (берем из шапки документа)
			    Если ЗначениеЗаполнено(Объект.itnНоменклатура) Тогда
			        НовУслуга.Субконто1 = Объект.itnНоменклатура;
			    КонецЕсли;
			Исключение
			КонецПопытки;			
			// === СЧЕТА УЧЕТА ===
			Попытка
				Если ЗначениеЗаполнено(Объект.itnСчетЗатрат) Тогда
					НовУслуга.СчетЗатрат = Объект.itnСчетЗатрат;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			// === СТАТЬЯ ЗАТРАТ ===
			Попытка
				Если ЗначениеЗаполнено(Объект.itnСтатьяЗатрат) Тогда
					НовУслуга.СтатьяЗатрат = Объект.itnСтатьяЗатрат;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			// === ПОДРАЗДЕЛЕНИЕ ===
			Попытка
				Если ЗначениеЗаполнено(Объект.itnПодразделение) Тогда
					НовУслуга.ПодразделениеЗатрат = Объект.itnПодразделение;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	Сообщить("Распределение выполнено. Создано услуг: " + Индекс);
	
КонецПроцедуры