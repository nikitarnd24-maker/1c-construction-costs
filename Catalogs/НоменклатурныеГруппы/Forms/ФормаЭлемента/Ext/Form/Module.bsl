////////////////////////////////////////////////////////////////////////////////
// ДОРАБОТКА СУЩЕСТВУЮЩЕЙ ФОРМЫ СПРАВОЧНИКА НОМЕНКЛАТУРНЫЕГРУППЫ

&После("ПриСозданииНаСервере")
Процедура Расш_ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Скрываем поля для групп
	Если Объект.ЭтоГруппа Тогда
		Элементы.Площадь.Видимость = Ложь;
		Элементы.Использовать.Видимость = Ложь;
	КонецЕсли;
	
	// Загружаем значения из регистра
	Расш_ЗагрузитьЗначенияИзРегистра();
	
КонецПроцедуры

&После("ПередЗаписьюНаСервере")
Процедура Расш_ПослеПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Сохраняем значения в регистр
	Если НЕ ТекущийОбъект.ЭтоГруппа И НЕ ТекущийОбъект.Ссылка.Пустая() Тогда
		// Передаём значения прямо из реквизитов объекта
		Расш_СохранитьЗначенияВРегистр(ТекущийОбъект.Ссылка, ТекущийОбъект.Площадь, ТекущийОбъект.Использовать);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Расш_ЗагрузитьЗначенияИзРегистра()
	
	// Для новых элементов или групп ничего не загружаем
	Если Объект.Ссылка.Пустая() ИЛИ Объект.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеСвойстваНоменклатурныхГрупп.Площадь,
	|	ДополнительныеСвойстваНоменклатурныхГрупп.Используется
	|ИЗ
	|	РегистрСведений.ДополнительныеСвойстваНоменклатурныхГрупп КАК ДополнительныеСвойстваНоменклатурныхГрупп
	|ГДЕ
	|	ДополнительныеСвойстваНоменклатурныхГрупп.НоменклатурнаяГруппа = &НоменклатурнаяГруппа";
	
	Запрос.УстановитьПараметр("НоменклатурнаяГруппа", Объект.Ссылка);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		// Заполняем реквизиты объекта
		Объект.Площадь = Выборка.Площадь;
		Объект.Использовать = Выборка.Используется;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Расш_СохранитьЗначенияВРегистр(СсылкаНаОбъект, ЗначПлощадь, ЗначИспользовать)
	
	МенеджерЗаписи = РегистрыСведений.ДополнительныеСвойстваНоменклатурныхГрупп.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.НоменклатурнаяГруппа = СсылкаНаОбъект;
	МенеджерЗаписи.Площадь = ЗначПлощадь;
	МенеджерЗаписи.Используется = ЗначИспользовать;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры